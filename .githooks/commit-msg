#!/bin/sh
# Conventional Commits check for the PrimeGraph core packages.
#
# Dependency-free POSIX shell so the Go, Swift, Kotlin and Python repos do not
# have to install node tooling just to validate a commit message. The rules
# mirror @commitlint/config-conventional as configured in the monorepo:
#
#   type(scope)!: subject
#
#   - type is one of the standard set below, lowercase
#   - scope is optional, lowercase, and wrapped in parentheses
#   - "!" marks a breaking change and is optional
#   - the whole header is at most 100 characters
#   - the subject is non-empty and does not end with a period
#
# Enable it once per clone with:  git config core.hooksPath .githooks
# (scripts/setup.sh does this for you.)

set -e

MSG_FILE="$1"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  echo "commit-msg: no commit message file was supplied" >&2
  exit 1
fi

MAX_HEADER_LENGTH=100
TYPES='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'

# The header is the first line that is neither blank nor a git comment.
HEADER=$(grep -v '^#' "$MSG_FILE" | grep -v '^[[:space:]]*$' | head -1)

if [ -z "$HEADER" ]; then
  echo "commit-msg: the commit message is empty" >&2
  exit 1
fi

# Messages git writes itself, and the autosquash markers, are not authored by a
# human and are therefore exempt.
case "$HEADER" in
  'Merge '*|'Revert "'*|'fixup!'*|'squash!'*|'amend!'*)
    exit 0
    ;;
esac

reject() {
  echo "commit-msg: $1" >&2
  echo >&2
  echo "  header: $HEADER" >&2
  echo >&2
  echo "Expected Conventional Commits:  type(scope)!: subject" >&2
  echo "  type    one of: build chore ci docs feat fix perf refactor revert style test" >&2
  echo "  scope   optional, lowercase, e.g. feat(models): ..." >&2
  echo "  !       optional, marks a breaking change" >&2
  echo "  subject non-empty, no trailing period" >&2
  echo "  header  at most $MAX_HEADER_LENGTH characters" >&2
  exit 1
}

if ! printf '%s' "$HEADER" | grep -Eq "^(${TYPES})(\([a-z0-9][a-z0-9._/-]*\))?!?: .+$"; then
  reject "the header does not match the Conventional Commits format"
fi

if [ "${#HEADER}" -gt "$MAX_HEADER_LENGTH" ]; then
  reject "the header is ${#HEADER} characters, the limit is $MAX_HEADER_LENGTH"
fi

case "$HEADER" in
  *.)
    reject "the subject must not end with a period"
    ;;
esac

exit 0
